{
  "name": "@tscircuit/ti-system-block-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "build:standalone": "bun run typecheck && vite build --config vite.standalone.config.ts && bun run scripts/inline-standalone.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/alphabet": "0.0.26",
    "@tscircuit/core": "0.0.1775",
    "@tscircuit/eval": "0.0.1287",
    "@tscircuit/infer-cable-insertion-point": "0.0.4",
    "@xyflow/react": "12.11.5",
    "circuit-json": "0.0.476",
    "circuit-to-svg": "0.0.408",
    "comlink": "4.4.2",
    "jspdf": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svg2pdf.js": "2.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
